# Copia este archivo a .env.local y completa los valores. .env.local NO se sube al repo.
# Valores en Supabase → Project Settings → API Keys.

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxx

# Solo servidor. Esta llave SALTA las políticas RLS: nunca en código que llegue al
# navegador ni en una variable NEXT_PUBLIC_*. Se usa únicamente en scripts de seed
# o administración que corren en servidor.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxx

# ── Asistente de IA (HU-15). Solo servidor: ninguna va con NEXT_PUBLIC_. ──────
# Si IA_API_KEY falta, la aplicación arranca igual y el panel dice que el
# asistente no está configurado. Las demás tienen valor por defecto.
IA_PROVEEDOR=groq                       # hoy el único soportado (src/lib/ai/proveedor.ts)
IA_API_KEY=gsk_xxxxxxxxxxxx             # llave de https://console.groq.com/keys
IA_MODELO=llama-3.3-70b-versatile       # modelo de producción de Groq con tool use
IA_MAX_MENSAJES_CONTEXTO=12             # cuántos mensajes previos se mandan al modelo
IA_MAX_CARACTERES_CONTEXTO=4000         # tope de caracteres de esa conversación previa (los proveedores limitan tokens por minuto)
IA_MAX_TOKENS_RESPUESTA=600
IA_TEMPERATURA=0.2                      # bajo: responde con datos, no inventa
IA_MAX_PASOS_HERRAMIENTAS=4             # cuántas consultas puede encadenar por pregunta
IA_TIEMPO_MAXIMO_MS=20000
